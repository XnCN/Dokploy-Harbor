# Dokploy > Compose > Environment. No real secrets belong in Git.
# Replace the hostname and both passwords; instance ID becomes the permanent volume prefix.
HARBOR_INSTANCE_ID=harbor-prod
HARBOR_HOSTNAME=harbor.example.com
HARBOR_ADMIN_PASSWORD=
HARBOR_DB_PASSWORD=
DOKPLOY_NETWORK=dokploy-network

# Optional backup. Set false to deploy without S3 credentials or automatic downtime.
BACKUP_ENABLED=true
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_MAX_AGE_HOURS=26

# Optional HTTPS notification receiver. Receives JSON state/instance/time, never secrets.
NOTIFICATION_WEBHOOK=
NOTIFICATION_BEARER_TOKEN=
HEALTH_TIMEOUT_SECONDS=300

# Used only by explicitly invoked policy/GC jobs. Use the current admin password.
# Leave blank until needed; changing the initial password does not rotate existing users.
HARBOR_API_USERNAME=admin
HARBOR_API_PASSWORD=
POLICY_PROJECTS=library,production,development
PROJECT_QUOTA_GIB=20
RETENTION_KEEP_COUNT=20
RETENTION_KEEP_DAYS=30

# Harbor configuration changes require the maintenance job before redeploy.
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
POSTGRES_MAX_CONNECTIONS=256
JOB_MAX_WORKERS=5
HARBOR_LOG_LEVEL=info
CACHE_ENABLED=true
ALLOW_PRIVATE_NETWORK_ACCESS=false
TRIVY_GITHUB_TOKEN=
TRIVY_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-db
TRIVY_JAVA_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-java-db
HARBOR_HTTP_PROXY=
HARBOR_HTTPS_PROXY=
HARBOR_NO_PROXY=
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5

# Budget is for Harbor; leave additional resources for Dokploy and other applications.
INIT_MEMORY_LIMIT=768m
OPERATIONS_MEMORY_LIMIT=128m
CORE_MEMORY_LIMIT=1g
POSTGRESQL_MEMORY_LIMIT=1536m
REDIS_MEMORY_LIMIT=256m
REGISTRY_MEMORY_LIMIT=768m
REGISTRYCTL_MEMORY_LIMIT=128m
JOBSERVICE_MEMORY_LIMIT=512m
PORTAL_MEMORY_LIMIT=128m
PROXY_MEMORY_LIMIT=256m
TRIVY_ADAPTER_MEMORY_LIMIT=1536m
EXPORTER_MEMORY_LIMIT=128m
CORE_CPU_LIMIT=1.0
POSTGRESQL_CPU_LIMIT=1.0
REDIS_CPU_LIMIT=1.0
REGISTRY_CPU_LIMIT=1.0
REGISTRYCTL_CPU_LIMIT=1.0
JOBSERVICE_CPU_LIMIT=1.0
PORTAL_CPU_LIMIT=1.0
PROXY_CPU_LIMIT=1.0
TRIVY_ADAPTER_CPU_LIMIT=2.0
EXPORTER_CPU_LIMIT=1.0

# Scanner metadata freshness checked by the monitoring job.
TRIVY_DB_MAX_AGE_HOURS=48
# Suppress expected health downtime but alert on maintenance exceeding this duration.
MAINTENANCE_MAX_HOURS=4
